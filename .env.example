# Required in production
DATABASE_URL=jdbc:postgresql://localhost:5434/titlerate
DB_DRIVER=org.postgresql.Driver
DB_USER=titlerate
# Matches POSTGRES_PASSWORD in docker-compose.yml, which creates the database
# this connects to. Change both together, or the quickstart fails Flyway with
# a password authentication error after everything else has already worked.
DB_PASSWORD=titlerate

# Generate one: openssl rand -base64 32
# Left blank, the app signs with a random per-process key and warns.
JWT_SECRET=

# Optional
JWT_EXPIRATION_HOURS=24
SPRING_PROFILES_ACTIVE=prod
